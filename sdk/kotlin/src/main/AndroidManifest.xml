<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Model downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets apps see the Den app on Android 11+ (package visibility), for connected mode. -->
    <queries>
        <intent>
            <action android:name="ai.fanak.den.BIND" />
        </intent>
    </queries>

    <application>
        <!-- The engine of embedded mode in its own process: a native crash ends this process, not the app. -->
        <service
            android:name="ai.fanak.den.EngineService"
            android:exported="false"
            android:process=":den_engine" />
    </application>
</manifest>
